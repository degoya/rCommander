# rCommander's winget installer manifest (RC-100-53). Rendered from
# packaging/winget/degoya.rCommander.installer.yaml.in in @REPOSITORY@ by
# scripts/package-managers.sh and submitted to microsoft/winget-pkgs by the release workflow:
# change the template, not this file.
#
# The portable Windows zip, extracted as a whole into
# %LOCALAPPDATA%\Microsoft\WinGet\Packages\degoya.rCommander_<source>\, the program in the zip's
# version folder. That folder goes on PATH instead of a link in WinGet\Links
# (ArchiveBinariesDependOnPath): rCommander installs its bundled plugins from plugins\ beside the
# executable it was started as. A portable package installs per user; winget refuses a `Scope` on
# one. package-channels.yml proves `rcommander` resolves into the package folder.
# yaml-language-server: $schema=https://aka.ms/winget-manifest.installer.1.12.0.schema.json

PackageIdentifier: degoya.rCommander
PackageVersion: @VERSION@
InstallerType: zip
NestedInstallerType: portable
NestedInstallerFiles:
- RelativeFilePath: rcommander-@VERSION@-windows-x64\rcommander.exe
  PortableCommandAlias: rcommander
ArchiveBinariesDependOnPath: true
Commands:
- rcommander
Installers:
- Architecture: x64
  InstallerUrl: @BASE_URL@/rcommander-@VERSION@-windows-x64.zip
  InstallerSha256: @SHA256_WINDOWS_X64_UPPER@
ManifestType: installer
ManifestVersion: 1.12.0
